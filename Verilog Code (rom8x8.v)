module rom8x8 (
    input  [2:0] address,
    output reg [7:0] data
);

always @(*) begin
    case(address)
        3'b000: data = 8'b00000011; // 3
        3'b001: data = 8'b00000110; // 6
        3'b010: data = 8'b00001001; // 9
        3'b011: data = 8'b00001100; // 12
        3'b100: data = 8'b00001111; // 15
        3'b101: data = 8'b00010010; // 18
        3'b110: data = 8'b00010101; // 21
        3'b111: data = 8'b00011000; // 24
        default: data = 8'b00000000;
    endcase
end

endmodule